// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EtapaProcesso {
  CADASTRO
  DS160_PREENCHIDO
  PAGAMENTO_MRV
  AGENDAMENTO_ENTREVISTA
  ENTREVISTA_REALIZADA
  VISTO_APROVADO
  VISTO_NEGADO
  PASSAPORTE_DEVOLVIDO
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  cpf       String?  @unique
  email     String?
  telefone  String?

  numeroPassaporte    String?
  validadePassaporte  DateTime?

  etapaAtual   EtapaProcesso @default(CADASTRO)
  dataEntrevista DateTime?

  valorTaxaMrv    Float?
  dataPagamentoMrv DateTime?

  observacoes String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico HistoricoEtapa[]
}

model HistoricoEtapa {
  id        String        @id @default(cuid())
  clienteId String
  cliente   Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  etapa     EtapaProcesso
  observacao String?
  criadoEm  DateTime      @default(now())

  @@index([clienteId])
}
