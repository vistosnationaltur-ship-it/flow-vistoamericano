// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EtapaProcesso {
  CADASTRO
  CONTRATO_ENVIADO
  RASCUNHO_DS160_SOLICITADO
  DS160_PREENCHIDO
  BOLETO_MRV_GERADO
  PAGAMENTO_MRV
  AGENDAMENTO_ENTREVISTA
  INSTRUCOES_PASSADAS
  ENTREVISTA_REALIZADA
  VISTO_APROVADO
  VISTO_NEGADO
  PASSAPORTE_DEVOLVIDO
}

enum Role {
  ADMIN
  USUARIO
}

model Usuario {
  id        String   @id @default(cuid())
  username  String   @unique
  senhaHash String
  role      Role     @default(USUARIO)
  criadoEm  DateTime @default(now())
}

model Grupo {
  id   String @id @default(cuid())
  nome String

  // Pagamento do serviço de assessoria costuma ser combinado por
  // família (um valor só, justificado pelo número de pessoas), por
  // isso fica no grupo em vez de em cada cliente.
  valorServico          Float?
  dataPagamentoServico  DateTime?
  observacoesFinanceiras String?

  criadoEm DateTime @default(now())

  clientes Cliente[]
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  cpf       String?  @unique
  email     String?
  telefone  String?
  dataNascimento DateTime?
  endereco  String?
  numeroDs160 String?

  numeroPassaporte    String?
  validadePassaporte  DateTime?
  dataVencimentoVistoAtual DateTime?

  etapaAtual   EtapaProcesso @default(CADASTRO)
  dataEntrevista DateTime?
  contratoEnviadoEm DateTime?

  valorTaxaMrv    Float?
  dataPagamentoMrv DateTime?

  // Valor cobrado pela assessoria em si (diferente da taxa MRV, que é
  // repassada ao consulado). Só usado quando o cliente NÃO está num
  // grupo familiar — nesse caso o valor fica no Grupo, compartilhado.
  valorServico         Float?
  dataPagamentoServico DateTime?

  grupoId String?
  grupo   Grupo?  @relation(fields: [grupoId], references: [id])

  observacoes String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico HistoricoEtapa[]
  documentos Documento[]
  contratos  Contrato[]

  @@index([grupoId])
}

model Contrato {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  conteudoHtml          String
  authentiqueDocumentId String?
  enviadoEm             DateTime @default(now())

  @@index([clienteId])
}

model Documento {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Tipo é texto livre em vez de enum pra não travar cada assessoria
  // num conjunto fixo de documentos (ex: "Foto do passaporte",
  // "Comprovante DS-160", "Comprovante financeiro").
  tipo        String
  nomeArquivo String
  url         String

  criadoEm DateTime @default(now())

  @@index([clienteId])
}

model HistoricoEtapa {
  id        String        @id @default(cuid())
  clienteId String
  cliente   Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  etapa     EtapaProcesso
  observacao String?
  criadoEm  DateTime      @default(now())

  @@index([clienteId])
}
